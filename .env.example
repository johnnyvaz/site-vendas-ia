# Variáveis de Ambiente - Vendas.IA
# Copie este arquivo para .env.local e configure as variáveis conforme necessário

# ========================================
# N8N WEBHOOK CONFIGURATION
# ========================================

# URLs dos webhooks do n8n (Development)
VITE_N8N_WEBHOOK_URL_DEV=http://localhost:5678/webhook
VITE_N8N_AUTH_TOKEN_DEV=dev-webhook-token-change-me

# URLs dos webhooks do n8n (Production)
VITE_N8N_WEBHOOK_URL_PROD=https://your-n8n-instance.com/webhook
VITE_N8N_AUTH_TOKEN_PROD=your-production-webhook-token

# Chave secreta para validação de assinatura
VITE_N8N_SECRET_KEY=vendas-ia-secret-key-change-me

# ========================================
# ANALYTICS E TRACKING
# ========================================

# Google Analytics (se aplicável)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Hotjar (se aplicável)
VITE_HOTJAR_ID=your-hotjar-id

# ========================================
# WHATSAPP CONFIGURATION
# ========================================

# Número do WhatsApp (formato brasileiro sem +55)
VITE_WHATSAPP_NUMBER=5516997787674

# ========================================
# APLICAÇÃO
# ========================================

# URL base da aplicação
VITE_APP_URL=https://vendas.ia.br

# Versão da aplicação
VITE_APP_VERSION=1.0.0

# ========================================
# FEATURES FLAGS
# ========================================

# Habilitar analytics em desenvolvimento
VITE_ENABLE_ANALYTICS_DEV=false

# Habilitar debug logs
VITE_ENABLE_DEBUG_LOGS=true

# Habilitar validação LGPD rigorosa
VITE_STRICT_LGPD=true

# ========================================
# INTEGRAÇÕES OPCIONAIS
# ========================================

# Supabase (se usar banco de dados)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SendGrid (se usar para emails)
VITE_SENDGRID_API_KEY=your-sendgrid-api-key

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================

# Porta do servidor de desenvolvimento
PORT=3000

# Modo de desenvolvimento
NODE_ENV=development

# Habilitar source maps
VITE_SOURCE_MAP=true

# ========================================
# EXEMPLO DE CONFIGURAÇÃO MÍNIMA PARA COMEÇAR
# ========================================

# Para testar localmente, você precisará pelo menos:
# 1. VITE_N8N_WEBHOOK_URL_DEV (URL do seu n8n local)
# 2. VITE_N8N_AUTH_TOKEN_DEV (token de autenticação)
# 3. VITE_WHATSAPP_NUMBER (seu número do WhatsApp)

# Exemplo de configuração mínima:
# VITE_N8N_WEBHOOK_URL_DEV=http://localhost:5678/webhook/vendas-ia
# VITE_N8N_AUTH_TOKEN_DEV=abc123456789
# VITE_WHATSAPP_NUMBER=5516997787674